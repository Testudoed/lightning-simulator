[Unit]
Description=Lightning simulator and PicoSTORM input controller
Wants=pipewire.service pipewire-pulse.service wireplumber.service
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/Workspace/lightning-simulator
ExecStart=%h/Workspace/lightning-simulator/.venv/bin/lightning-simulator --config %h/.config/lightning-simulator/config.toml
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
